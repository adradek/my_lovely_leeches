<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6 text-gray-900">New Import Source</h1>

  <%= form_with model: @import_source, local: true, multipart: true,
                html: { class: "space-y-5 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" } do |f| %>
    <% if @import_source.errors.any? %>
      <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
        <h2 class="font-semibold mb-2">
          <%= pluralize(@import_source.errors.count, "error") %> prohibited this import source from being saved:
        </h2>
        <ul class="list-disc list-inside">
          <% @import_source.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div data-controller="format-switch"
         data-format-switch-url-value="<%= new_import_source_path %>"
         data-format-switch-frame-value="format_fields">
      <%= f.label :format, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :format,
                   ImportSource.formats.keys.map { |k| [k.upcase, k] },
                   {},
                   data: {
                     format_switch_target: "select",
                     action: "change->format-switch#change"
                   },
                   class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500" %>
    </div>

    <%= turbo_frame_tag "format_fields" do %>
      <%= render format_fields_partial_for(@import_source.format), f: f, import_source: @import_source %>
    <% end %>

    <div class="flex items-center gap-3">
      <%= f.submit "Create Import Source",
                   class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      <%= link_to "Cancel", imports_path,
                  class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
    </div>
  <% end %>
</div>
