<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Import Source #<%= @import_source.id %></h1>
    <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-800">
      <%= @import_source.format.upcase %>
    </span>
  </div>

  <dl class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white shadow-sm">
    <div class="grid grid-cols-3 gap-4 px-4 py-3">
      <dt class="text-sm font-medium text-gray-500">Name</dt>
      <dd class="col-span-2 text-sm text-gray-900"><%= @import_source.name.presence || "—" %></dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-4 py-3">
      <dt class="text-sm font-medium text-gray-500">Source</dt>
      <dd class="col-span-2 text-sm text-gray-900">
        <% if @import_source.source.attached? %>
          <%= link_to @import_source.source.filename.to_s, url_for(@import_source.source),
                      class: "text-blue-700 hover:underline" %>
          <span class="text-xs text-gray-500 ml-1">
            (<%= number_to_human_size(@import_source.source.byte_size) %>)
          </span>
        <% else %>
          —
        <% end %>
      </dd>
    </div>
    <div class="grid grid-cols-3 gap-4 px-4 py-3">
      <dt class="text-sm font-medium text-gray-500">Created at</dt>
      <dd class="col-span-2 text-sm text-gray-900"><%= @import_source.created_at %></dd>
    </div>
  </dl>

  <div class="mt-6">
    <h2 class="text-lg font-medium text-gray-900 mb-2">Sheets</h2>
    <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-6 text-sm text-gray-500">
      <%= render_sheets(@import_source) %>
    </div>
  </div>

  <div class="mt-6 flex items-center gap-3">
    <%= link_to "Back to Imports", imports_path,
                class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
  </div>
</div>
