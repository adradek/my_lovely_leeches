<div class="space-y-2">
  <%= f.label :source, "Excel file (.xls / .xlsx)",
              class: "block text-sm font-medium text-gray-700" %>
  <%= f.file_field :source,
                   accept: ".xls,.xlsx,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                   class: "block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-blue-600 file:text-white hover:file:bg-blue-700" %>
</div>
