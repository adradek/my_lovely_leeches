<%= form_with model: import, local: true, multipart: true,
              html: { class: "space-y-5 rounded-lg border border-gray-200 bg-white p-6 shadow-sm" } do |f| %>
  <% if import.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-700">
      <h2 class="font-semibold mb-2">
        <%= pluralize(import.errors.count, "error") %> prohibited this import from being saved:
      </h2>
      <ul class="list-disc list-inside">
        <% import.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :file, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.file_field :file,
                     accept: ".xlsx,.xls,.csv,.json",
                     class: "block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-blue-600 file:text-white hover:file:bg-blue-700" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "Create Import",
                 class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
    <%= link_to "Cancel", imports_path,
                class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
  </div>
<% end %>
